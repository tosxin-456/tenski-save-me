# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/kashe?sslmode=require

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_EXPIRES_DAYS=7

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ─── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MODEL_DIR=models
MAX_UPLOAD_MB=20
